{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "typeRoots": ["node_modules/@types", "./node_modules/@earendil-works/pi-coding-agent/node_modules/@types"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "tests", "**/node_modules/**"]
}