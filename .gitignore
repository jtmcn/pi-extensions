# Test harness deps
tests/node_modules/

# The root package.json has no dependencies, but npm still creates this
/node_modules/

# Extension deps, if an extension ever needs npm packages
*/node_modules/

# Editor / OS noise
.DS_Store
*.log

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Default worktree location — the worktree extension's `path` puts checkouts
# inside the repo, so every worktree would otherwise show up as untracked.
.claude/
